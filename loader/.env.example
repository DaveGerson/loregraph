# Keep secrets in an ignored local env file. The application reads these only
# when the corresponding optional sink/provider is used.
OPENAI_API_KEY=
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional MCP server defaults (CLI flags win). Pass this file with
# `loregraph-mcp --env-file .env` so MCP client configs need not hold secrets.
# LOREGRAPH_MCP_AUDIENCE=player
# LOREGRAPH_MCP_CONNECTION=aura

