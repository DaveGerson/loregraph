{
  "schema_version": "2.0.0-loregraph",
  "design": {
    "authoritative_statement": "Assertion",
    "leaf_typing": "subtype controlled concept",
    "direct_edges": "rebuildable projections carrying assertionId",
    "source_chain": ["Material", "MaterialVersion", "SourceFragment", "KnowledgeChunk"],
    "identity_rule": "One stable entity per referent and scope; uncertain matches remain separate.",
    "profile_rule": "Use the smallest closed profile that fits a source; setting packs extend rather than redefine the core."
  },
  "node_types": {
    "Person": {"description":"A real or documented individual, distinct from a fictional Character identity.","subtypes":["person","author","expert","contact","stakeholder","other"]},
    "Organization": {"description":"A real or documented company, institution, team, government, or community.","subtypes":["company","institution","team","government","community","other"]},
    "Topic": {"description":"A stable subject, theme, domain, or controlled knowledge concept.","subtypes":["subject","theme","domain","tag","concept","other"]},
    "Project": {"description":"A bounded initiative or area of ongoing work.","subtypes":["project","initiative","area","other"]},
    "ActionItem": {"description":"A task, follow-up, milestone, or reminder extracted from notes.","subtypes":["task","follow-up","milestone","reminder","other"]},
    "Decision": {"description":"A recorded choice with context, rationale, status, and provenance.","subtypes":[]},
    "Question": {"description":"An open or answered question worth tracking across sources.","subtypes":["open","answered","research","other"]},
    "Event": {"description":"A real-world or domain-neutral occurrence, including a meeting or deadline.","subtypes":["meeting","deadline","milestone","incident","other"]},
    "Character": {"description":"Persistent fictional individual; PC/NPC is a contextual role, not an identity type.","subtypes":["person","npc","player-character","named-creature","other"]},
    "CreatureArchetype": {"description":"Lore identity for a kind of creature, separate from an individual and a stat block.","subtypes":["monster","animal","construct","undead","other"]},
    "Faction": {"description":"Persistent organized group, including nations, dragonmarked houses, churches, agencies, guilds, and military groups.","subtypes":["nation","dragonmarked-house","church","cult","agency","guild","military","crime-group","other"]},
    "Location": {"description":"A real or fictional place at any scale; use subtype for region, settlement, structure, room, route, or other domain-specific level.","subtypes":["plane","continent","nation-region","region","city","settlement","district","site","structure","dungeon","dungeon-room","route","other"]},
    "HistoricalEvent": {"description":"An in-world historical occurrence or event complex.","subtypes":["era","war","battle","treaty","catastrophe","founding","succession","other"]},
    "TimeInstant": {"description":"A point-like real or fictional time expression with preserved wording, calendar, precision, and uncertainty.","subtypes":[]},
    "TimeInterval": {"description":"A real or fictional interval with optional beginning and ending instants.","subtypes":[]},
    "LoreEntity": {"description":"Setting concept that is not better represented by another stable class.","subtypes":["religion","deity","culture","species","language","dragonmark","industry","technology","artifact","law","office","concept","other"]},
    "GameSystem": {"description":"Stable product or mechanics family, independent of a particular release.","subtypes":[]},
    "Ruleset": {"description":"A mechanically coherent rules family within a game system.","subtypes":[]},
    "RuleElement": {"description":"Stable identity of a rule, option, spell, condition, item, feature, or controlled game term.","subtypes":["rule","class","subclass","species-option","background","feat","feature","spell","condition","item","weapon","armor","skill","damage-type","other"]},
    "RuleElementVersion": {"description":"Exact citable version of one rule element for a pinned ruleset version.","subtypes":[]},
    "RulesetVersion": {"description":"Immutable citable release or errata baseline such as SRD 5.2.1.","subtypes":[]},
    "StatBlock": {"description":"Rules template for one ruleset version, separate from creature archetype and individual.","subtypes":[]},
    "StatDefinition": {"description":"Typed statistic definition such as a number, rating, die, modifier, or formula.","subtypes":[]},
    "ResourceDefinition": {"description":"Trackable pool or currency such as hit points, stress, slots, heat, or tokens.","subtypes":[]},
    "DiceExpression": {"description":"Parsed and original dice or other resolution expression.","subtypes":[]},
    "ConversionMapping": {"description":"Versioned mapping between rules concepts, including partial or review-required mappings.","subtypes":["exact","partial","renamed","split","merged","review-required"]},
    "ItemDefinition": {"description":"Reusable definition of an item, separate from an owned item instance.","subtypes":["mundane","magic-item","artifact","vehicle","other"]},
    "ItemInstance": {"description":"A particular owned, carried, equipped, awarded, or lost object in one campaign continuity.","subtypes":[]},
    "CharacterBuild": {"description":"Immutable or revisioned mechanical build at one point in character progression.","subtypes":[]},
    "CharacterState": {"description":"Runtime snapshot such as hit points, conditions, resources, location, and temporary effects.","subtypes":[]},
    "Campaign": {"description":"A sustained play continuity and its campaign canon.","subtypes":[]},
    "CampaignRevision": {"description":"Immutable revision of campaign-authored state, decisions, or canon.","subtypes":[]},
    "Party": {"description":"Group of characters acting together in a campaign.","subtypes":[]},
    "Adventure": {"description":"Reusable or campaign-adapted scenario.","subtypes":[]},
    "Session": {"description":"Real-world sitting or asynchronous play interval.","subtypes":[]},
    "Scene": {"description":"Prepared scene definition; distinct from its observed SceneRun.","subtypes":[]},
    "SceneRun": {"description":"A scene as actually played.","subtypes":[]},
    "Encounter": {"description":"Prepared goal-oriented challenge of any kind.","subtypes":["combat","social","exploration","investigation","puzzle","trap","chase","travel","downtime","stealth","mixed"]},
    "EncounterRun": {"description":"Observed execution of an encounter design.","subtypes":[]},
    "PlayEvent": {"description":"Atomic or aggregate occurred event established by table evidence.","subtypes":["action","state-change","discovery","travel","interaction","other"]},
    "NarrativeElement": {"description":"Plotline, arc, thread, clue, mystery, promise, payoff, choice, or consequence.","subtypes":["story-arc","character-arc","plotline","subplot","quest","mystery","clue","secret","choice","consequence","foreshadowing","payoff","other"]},
    "GMTool": {"description":"Rollable table, generator, clock, tracker, ruling, or prep aid.","subtypes":["rollable-table","generator","clock","tracker","house-rule","ruling","handout","other"]}
  },
  "predicates": {
    "AFFILIATED_WITH": {"domain":["Person"],"range":["Organization"],"temporal":true},
    "WORKS_ON": {"domain":["Person","Organization"],"range":["Project"],"temporal":true},
    "ABOUT": {"domain":["Project","ActionItem","Decision","Question","Event"],"range":["Person","Organization","Topic","Project","Event","Location","Character","Faction","LoreEntity"]},
    "PART_OF_PROJECT": {"domain":["ActionItem","Decision","Question","Event"],"range":["Project"]},
    "ASSIGNED_TO": {"domain":["ActionItem"],"range":["Person","Organization"],"temporal":true},
    "DEPENDS_ON": {"domain":["ActionItem","Project"],"range":["ActionItem","Project"],"acyclic":true},
    "RESOLVES_QUESTION": {"domain":["Decision"],"range":["Question"]},
    "RELATED_TO": {"domain":["Person","Organization","Topic","Project","ActionItem","Decision","Question","Event"],"range":["Person","Organization","Topic","Project","ActionItem","Decision","Question","Event","Location","Character","Faction","LoreEntity"]},
    "MEMBER_OF": {"domain":["Character","Faction"],"range":["Faction","Party"],"temporal":true},
    "LEADS": {"domain":["Character"],"range":["Faction"],"temporal":true},
    "HOLDS_OFFICE": {"domain":["Character"],"range":["LoreEntity"],"temporal":true},
    "OFFICE_OF": {"domain":["LoreEntity"],"range":["Faction"]},
    "SUCCEEDED": {"domain":["Character"],"range":["Character"]},
    "ALLIED_WITH": {"domain":["Faction"],"range":["Faction"],"temporal":true,"symmetric":true},
    "AT_WAR_WITH": {"domain":["Faction"],"range":["Faction"],"temporal":true,"symmetric":true},
    "RIVAL_OF": {"domain":["Faction","Character"],"range":["Faction","Character"],"symmetric":true},
    "OPPOSES": {"domain":["Faction","Character","LoreEntity"],"range":["Faction","Character","LoreEntity"]},
    "OPERATES_IN": {"domain":["Faction"],"range":["Location"],"temporal":true},
    "LOCATED_IN": {"domain":["Person","Organization","Event","Character","CharacterState","Faction","Location","ItemDefinition","ItemInstance","LoreEntity"],"range":["Location"],"temporal":true},
    "PART_OF_LOCATION": {"domain":["Location"],"range":["Location"],"acyclic":true},
    "CONNECTED_TO": {"domain":["Location"],"range":["Location"]},
    "BORDERS": {"domain":["Location","Faction"],"range":["Location","Faction"],"symmetric":true},
    "CAPITAL_OF": {"domain":["Location"],"range":["Faction"],"temporal":true},
    "HAS_MANIFEST_ZONE_TO": {"domain":["Location"],"range":["Location","LoreEntity"]},
    "INVOLVED": {"domain":["HistoricalEvent","SceneRun","EncounterRun","PlayEvent"],"range":["Character","Faction","Location","ItemInstance","LoreEntity"]},
    "OCCURRED_AT": {"domain":["HistoricalEvent","SceneRun","EncounterRun","PlayEvent"],"range":["Location"]},
    "OCCURRED_AT_TIME": {"domain":["Event","HistoricalEvent","SceneRun","EncounterRun","PlayEvent","CharacterState"],"range":["TimeInstant"]},
    "OCCURRED_DURING_TIME": {"domain":["Event","HistoricalEvent","SceneRun","EncounterRun","PlayEvent","CharacterState"],"range":["TimeInterval"]},
    "INTERVAL_START": {"domain":["TimeInterval"],"range":["TimeInstant"]},
    "INTERVAL_END": {"domain":["TimeInterval"],"range":["TimeInstant"]},
    "PART_OF_EVENT": {"domain":["Event","HistoricalEvent"],"range":["Event","HistoricalEvent"],"acyclic":true},
    "CAUSED_BY": {"domain":["HistoricalEvent","NarrativeElement"],"range":["HistoricalEvent","Character","Faction","LoreEntity","NarrativeElement"]},
    "RESULTED_IN": {"domain":["HistoricalEvent"],"range":["HistoricalEvent","Faction","Location","LoreEntity"]},
    "PARTICIPATED_IN": {"domain":["Character","Faction"],"range":["HistoricalEvent"]},
    "CREATED_BY": {"domain":["ItemDefinition","LoreEntity","RuleElement"],"range":["Character","Faction"]},
    "WORSHIPS": {"domain":["Character","Faction"],"range":["LoreEntity"]},
    "HOUSE_OF": {"domain":["Faction"],"range":["LoreEntity"]},
    "BEARS_MARK": {"domain":["Character"],"range":["LoreEntity"]},
    "MANIFESTS_IN": {"domain":["LoreEntity"],"range":["LoreEntity","Character"]},
    "MONOPOLIZES": {"domain":["Faction"],"range":["LoreEntity"]},
    "INSTANCE_OF": {"domain":["Character"],"range":["CreatureArchetype"]},
    "HAS_STAT_BLOCK": {"domain":["Character","CreatureArchetype"],"range":["StatBlock"]},
    "HAS_RULESET": {"domain":["GameSystem"],"range":["Ruleset"]},
    "HAS_RULESET_VERSION": {"domain":["Ruleset"],"range":["RulesetVersion"]},
    "FOR_RULESET_VERSION": {"domain":["RuleElementVersion","StatBlock","CharacterBuild","Campaign"],"range":["RulesetVersion"]},
    "VERSION_OF": {"domain":["RuleElementVersion"],"range":["RuleElement"]},
    "GRANTS": {"domain":["RuleElementVersion","LoreEntity"],"range":["RuleElement","RuleElementVersion"]},
    "REQUIRES": {"domain":["RuleElementVersion","RuleElement"],"range":["RuleElement","RuleElementVersion","LoreEntity"]},
    "OVERRIDES": {"domain":["RuleElementVersion","GMTool"],"range":["RuleElementVersion","RuleElement"]},
    "HAS_COMPONENT": {"domain":["StatBlock","RuleElementVersion"],"range":["RuleElementVersion","RuleElement"]},
    "DEFINES_STAT": {"domain":["RulesetVersion","StatBlock"],"range":["StatDefinition"]},
    "DEFINES_RESOURCE": {"domain":["RulesetVersion","StatBlock"],"range":["ResourceDefinition"]},
    "USES_DICE": {"domain":["RuleElementVersion","StatBlock"],"range":["DiceExpression"]},
    "MAPS_FROM": {"domain":["ConversionMapping"],"range":["RuleElementVersion","StatDefinition","ResourceDefinition"]},
    "MAPS_TO": {"domain":["ConversionMapping"],"range":["RuleElementVersion","StatDefinition","ResourceDefinition"]},
    "HAS_BUILD": {"domain":["Character"],"range":["CharacterBuild"]},
    "CURRENT_BUILD": {"domain":["Character"],"range":["CharacterBuild"]},
    "PREVIOUS_BUILD": {"domain":["CharacterBuild"],"range":["CharacterBuild"]},
    "USES_RULE_ELEMENT": {"domain":["CharacterBuild"],"range":["RuleElementVersion"]},
    "HAS_STATE": {"domain":["Character"],"range":["CharacterState"]},
    "CURRENT_STATE": {"domain":["Character"],"range":["CharacterState"]},
    "STATE_OF_BUILD": {"domain":["CharacterState"],"range":["CharacterBuild"]},
    "STATE_AT_SESSION": {"domain":["CharacterState"],"range":["Session"]},
    "HAS_ITEM": {"domain":["Character","Party","Faction"],"range":["ItemInstance"],"temporal":true},
    "INSTANCE_OF_ITEM": {"domain":["ItemInstance"],"range":["ItemDefinition"]},
    "EQUIPPED": {"domain":["Character"],"range":["ItemInstance"],"temporal":true},
    "REVISION_OF": {"domain":["CampaignRevision"],"range":["Campaign"]},
    "SUPERSEDES": {"domain":["CampaignRevision"],"range":["CampaignRevision"]},
    "IN_CAMPAIGN": {"domain":["Character","Faction","Location","HistoricalEvent","Party","Adventure","Session","Scene","SceneRun","Encounter","EncounterRun","PlayEvent","NarrativeElement","GMTool","CharacterBuild","CharacterState","ItemInstance","CampaignRevision","TimeInstant","TimeInterval"],"range":["Campaign"]},
    "PART_OF_ADVENTURE": {"domain":["Scene","Encounter","NarrativeElement"],"range":["Adventure"]},
    "PLANS_TO_RUN": {"domain":["Session"],"range":["Scene"]},
    "REALIZES": {"domain":["SceneRun","EncounterRun"],"range":["Scene","Encounter"]},
    "OCCURRED_IN": {"domain":["HistoricalEvent","SceneRun","EncounterRun","PlayEvent"],"range":["Session","SceneRun","EncounterRun"]},
    "PART_OF_NARRATIVE": {"domain":["NarrativeElement"],"range":["NarrativeElement","Adventure","Campaign"],"acyclic":true},
    "FOCUSES_ON": {"domain":["NarrativeElement"],"range":["Character","Faction","Location","LoreEntity"]},
    "ADVANCES": {"domain":["SceneRun","EncounterRun","PlayEvent","HistoricalEvent"],"range":["NarrativeElement"]},
    "RESOLVES": {"domain":["SceneRun","EncounterRun","PlayEvent","HistoricalEvent"],"range":["NarrativeElement"]},
    "FORESHADOWS": {"domain":["NarrativeElement","Scene"],"range":["NarrativeElement"]},
    "PAYS_OFF": {"domain":["NarrativeElement","SceneRun"],"range":["NarrativeElement"]},
    "REVEALS": {"domain":["SceneRun","HistoricalEvent","NarrativeElement"],"range":["NarrativeElement","Character","Faction","LoreEntity"]}
  },
  "profiles": {
    "lore": {
      "node_types":["Character","CreatureArchetype","Faction","Location","HistoricalEvent","TimeInstant","TimeInterval","LoreEntity","ItemDefinition"],
      "predicates":["MEMBER_OF","LEADS","HOLDS_OFFICE","OFFICE_OF","SUCCEEDED","ALLIED_WITH","AT_WAR_WITH","RIVAL_OF","OPPOSES","OPERATES_IN","LOCATED_IN","PART_OF_LOCATION","CONNECTED_TO","BORDERS","CAPITAL_OF","INVOLVED","OCCURRED_AT","OCCURRED_AT_TIME","OCCURRED_DURING_TIME","INTERVAL_START","INTERVAL_END","PART_OF_EVENT","CAUSED_BY","RESULTED_IN","PARTICIPATED_IN","CREATED_BY","WORSHIPS","INSTANCE_OF","HAS_STAT_BLOCK"]
    },
    "lore_eberron": {
      "node_types":["Character","CreatureArchetype","Faction","Location","HistoricalEvent","TimeInstant","TimeInterval","LoreEntity","ItemDefinition"],
      "predicates":["MEMBER_OF","LEADS","HOLDS_OFFICE","OFFICE_OF","SUCCEEDED","ALLIED_WITH","AT_WAR_WITH","RIVAL_OF","OPPOSES","OPERATES_IN","LOCATED_IN","PART_OF_LOCATION","CONNECTED_TO","BORDERS","CAPITAL_OF","HAS_MANIFEST_ZONE_TO","INVOLVED","OCCURRED_AT","OCCURRED_AT_TIME","OCCURRED_DURING_TIME","INTERVAL_START","INTERVAL_END","PART_OF_EVENT","CAUSED_BY","RESULTED_IN","PARTICIPATED_IN","CREATED_BY","WORSHIPS","HOUSE_OF","BEARS_MARK","MANIFESTS_IN","MONOPOLIZES","INSTANCE_OF","HAS_STAT_BLOCK"]
    },
    "rules": {
      "node_types":["CreatureArchetype","LoreEntity","GameSystem","Ruleset","RuleElement","RuleElementVersion","RulesetVersion","StatBlock","StatDefinition","ResourceDefinition","DiceExpression","ConversionMapping","ItemDefinition"],
      "predicates":["INSTANCE_OF","HAS_STAT_BLOCK","HAS_RULESET","HAS_RULESET_VERSION","FOR_RULESET_VERSION","VERSION_OF","GRANTS","REQUIRES","OVERRIDES","HAS_COMPONENT","DEFINES_STAT","DEFINES_RESOURCE","USES_DICE","MAPS_FROM","MAPS_TO","CREATED_BY"]
    },
    "adventure": {
      "node_types":["Character","CreatureArchetype","Faction","Location","HistoricalEvent","LoreEntity","ItemDefinition","Adventure","Scene","Encounter","NarrativeElement","GMTool"],
      "predicates":["MEMBER_OF","LOCATED_IN","PART_OF_LOCATION","CONNECTED_TO","INVOLVED","OCCURRED_AT","CAUSED_BY","RESULTED_IN","INSTANCE_OF","HAS_STAT_BLOCK","PART_OF_ADVENTURE","PART_OF_NARRATIVE","FOCUSES_ON","FORESHADOWS","REVEALS"]
    },
    "campaign": {
      "node_types":["Character","Faction","Location","HistoricalEvent","TimeInstant","TimeInterval","LoreEntity","RulesetVersion","ItemDefinition","ItemInstance","Campaign","CampaignRevision","Party","Adventure","Session","Scene","SceneRun","Encounter","EncounterRun","PlayEvent","NarrativeElement","GMTool"],
      "predicates":["MEMBER_OF","LEADS","RIVAL_OF","OPPOSES","LOCATED_IN","CONNECTED_TO","INVOLVED","OCCURRED_AT","OCCURRED_AT_TIME","OCCURRED_DURING_TIME","INTERVAL_START","INTERVAL_END","CAUSED_BY","RESULTED_IN","FOR_RULESET_VERSION","HAS_ITEM","INSTANCE_OF_ITEM","EQUIPPED","REVISION_OF","SUPERSEDES","IN_CAMPAIGN","PART_OF_ADVENTURE","PLANS_TO_RUN","REALIZES","OCCURRED_IN","PART_OF_NARRATIVE","FOCUSES_ON","ADVANCES","RESOLVES","FORESHADOWS","PAYS_OFF","REVEALS"]
    },
    "character": {
      "node_types":["Character","Location","TimeInstant","TimeInterval","LoreEntity","RuleElement","RuleElementVersion","RulesetVersion","StatBlock","ItemDefinition","ItemInstance","CharacterBuild","CharacterState","Campaign","Session"],
      "predicates":["LOCATED_IN","OCCURRED_AT_TIME","OCCURRED_DURING_TIME","INTERVAL_START","INTERVAL_END","FOR_RULESET_VERSION","HAS_BUILD","CURRENT_BUILD","PREVIOUS_BUILD","USES_RULE_ELEMENT","HAS_STATE","CURRENT_STATE","STATE_OF_BUILD","STATE_AT_SESSION","HAS_ITEM","INSTANCE_OF_ITEM","EQUIPPED","IN_CAMPAIGN"]
    },
    "notes": {
      "node_types":["Person","Organization","Location","Event","TimeInstant","TimeInterval","Topic","Project","ActionItem","Decision","Question"],
      "predicates":["AFFILIATED_WITH","WORKS_ON","ABOUT","PART_OF_PROJECT","ASSIGNED_TO","DEPENDS_ON","RESOLVES_QUESTION","RELATED_TO","LOCATED_IN","OCCURRED_AT_TIME","OCCURRED_DURING_TIME","INTERVAL_START","INTERVAL_END","PART_OF_EVENT"]
    }
  }
}
